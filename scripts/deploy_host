#! /usr/bin/env nix-shell
#! nix-shell -i bash -p bash coreutils openssh bind.dnsutils nix
# shellcheck shell=bash
# Copyright (c) Joel Benway
# SPDX-License-Identifier: MIT

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)
ROOT_DIR="${SCRIPT_DIR}/.."

TARGET_HOST=""
TARGET_ADDRESS=""
REMOTE_USER="${USER}"
TEST_ONLY=false
BUILD_HOST=""
ASK_PASSWORD=true

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

info() {
  echo -e "${BLUE}==>${NC} $*"
}

success() {
  echo -e "${GREEN}==>${NC} $*"
}

warn() {
  echo -e "${YELLOW}==>${NC} $*"
}

error() {
  echo -e "${RED}ERROR:${NC} $*" >&2
}

usage() {
  cat <<EOF
Usage: $(basename "$0") [options] <hostname>

Safely deploy a NixOS configuration to a production host with canary healthchecks and automatic rollback.

Arguments:
  hostname             NixOS configuration name (e.g., michael, francis, zita, agnes, jerome)

Options:
  -t, --target ADDR    Target IP address or hostname (default: resolves <hostname>)
  -u, --user USER      Remote SSH user with sudo access (default: current user '${USER}')
  -b, --build-host H   Host on which to build derivations (default: target host)
  --test-only          Run 'nixos-rebuild test' and canaries without persisting to bootloader
  --no-ask-password    Do not prompt for remote sudo password (use with passwordless sudo)
  -h, --help           Show this help message
EOF
  exit "${1:-0}"
}

# Parse options
while [[ $# -gt 0 ]]; do
  case "$1" in
    -t | --target)
      [[ $# -ge 2 ]] || {
        error "Option $1 requires an argument."
        usage 1
      }
      TARGET_ADDRESS="$2"
      shift 2
      ;;
    -u | --user)
      [[ $# -ge 2 ]] || {
        error "Option $1 requires an argument."
        usage 1
      }
      REMOTE_USER="$2"
      shift 2
      ;;
    -b | --build-host)
      [[ $# -ge 2 ]] || {
        error "Option $1 requires an argument."
        usage 1
      }
      BUILD_HOST="$2"
      shift 2
      ;;
    --test-only)
      TEST_ONLY=true
      shift
      ;;
    --no-ask-password)
      ASK_PASSWORD=false
      shift
      ;;
    -h | --help)
      usage 0
      ;;
    -*)
      echo "Unknown option: $1" >&2
      usage 1
      ;;
    *)
      if [[ -z "$TARGET_HOST" ]]; then
        TARGET_HOST="$1"
        shift
      else
        echo "Unexpected argument: $1" >&2
        usage 1
      fi
      ;;
  esac
done

if [[ -z "$TARGET_HOST" ]]; then
  error "Missing required target hostname."
  usage 1
fi

if [[ -z "$TARGET_ADDRESS" ]]; then
  TARGET_ADDRESS="$TARGET_HOST"
fi

SSH_TARGET="${REMOTE_USER}@${TARGET_ADDRESS}"

run_ssh() {
  ssh -o BatchMode=yes -o ConnectTimeout=10 "${SSH_TARGET}" "$@"
}

run_ssh_sudo() {
  ssh -t -o ConnectTimeout=10 "${SSH_TARGET}" "sudo $*"
}

PREV_SYSTEM=""
SWITCH_STARTED=false

rollback() {
  trap - ERR
  local rollback_target="${PREV_SYSTEM:-/run/booted-system}"
  local current_system
  current_system=$(run_ssh "readlink -f /run/current-system" 2>/dev/null || true)

  if [[ -n "$PREV_SYSTEM" && "$current_system" == "$PREV_SYSTEM" && "$SWITCH_STARTED" == false ]]; then
    warn "Target host ${TARGET_HOST} is still running previous generation (${PREV_SYSTEM}); skipping rollback."
    exit 1
  fi

  error "Deployment verification failed! Initiating automatic rollback on ${TARGET_HOST} to ${rollback_target}..."
  if [[ "$SWITCH_STARTED" == true && -n "$PREV_SYSTEM" ]]; then
    if run_ssh_sudo "sh -c \"nix-env -p /nix/var/nix/profiles/system --set '${rollback_target}' && '${rollback_target}/bin/switch-to-configuration' switch\""; then
      warn "Successfully rolled back ${TARGET_HOST} to previous system generation (${rollback_target})."
    else
      error "CRITICAL: Automated rollback command failed on ${TARGET_HOST}!"
    fi
  else
    if run_ssh_sudo "'${rollback_target}/bin/switch-to-configuration' test"; then
      warn "Successfully rolled back ${TARGET_HOST} to previous system generation (${rollback_target})."
    else
      error "CRITICAL: Automated rollback command failed on ${TARGET_HOST}!"
    fi
  fi
  exit 1
}

# 1. Pre-flight checks
info "Performing pre-flight checks for ${TARGET_HOST} (${TARGET_ADDRESS})..."

if ! run_ssh "hostname" &>/dev/null; then
  error "Unable to reach ${SSH_TARGET} via SSH. Check network connectivity and credentials."
  exit 1
fi

REMOTE_HOSTNAME=$(run_ssh "hostname")
REMOTE_SHORT="${REMOTE_HOSTNAME%%.*}"
if [[ "$REMOTE_SHORT" != "$TARGET_HOST" ]]; then
  error "Target host identity mismatch: expected '${TARGET_HOST}', but connected to '${REMOTE_HOSTNAME}' (${SSH_TARGET})!"
  exit 1
fi
info "Connected to remote host: ${REMOTE_HOSTNAME}"

PREV_SYSTEM=$(run_ssh "readlink -f /run/current-system")
if [[ ! "$PREV_SYSTEM" =~ ^/nix/store/[A-Za-z0-9._+-]+$ ]]; then
  error "Failed to resolve valid /run/current-system on ${TARGET_HOST} (got '${PREV_SYSTEM}')."
  exit 1
fi
info "Previous live generation on ${TARGET_HOST}: ${PREV_SYSTEM}"

# 2. Stage deployment with 'test'
info "Deploying configuration to ${TARGET_HOST} via 'nixos-rebuild test'..."

ELEVATE_FLAG="--ask-sudo-password"
if [ "$ASK_PASSWORD" = false ]; then
  ELEVATE_FLAG="--elevate=sudo"
fi

NIX_OPTIONS=(
  --option extra-trusted-public-keys "zita-cache-1:NZnUaNEPyAcPpeqdhZscnTzryEAw1mqA37W7v18lDWQ="
  --option fallback true
)

REBUILD_CMD=(nixos-rebuild test --flake "${ROOT_DIR}#${TARGET_HOST}" --target-host "${SSH_TARGET}" "$ELEVATE_FLAG" "${NIX_OPTIONS[@]}")

if [[ -n "$BUILD_HOST" ]]; then
  REBUILD_CMD+=(--build-host "$BUILD_HOST")
fi

if ! "${REBUILD_CMD[@]}"; then
  error "nixos-rebuild test failed on ${TARGET_HOST}."
  rollback
fi

success "Configuration activated in memory on ${TARGET_HOST}. Running canary checks..."

verify_canaries() {
  # Check systemd failed units (informational)
  FAILED_UNITS=$(run_ssh "systemctl --failed --plain --no-legend 2>/dev/null | wc -l" || echo "1")
  if [[ "$FAILED_UNITS" -gt 0 ]]; then
    warn "Detected $FAILED_UNITS failed systemd units on ${TARGET_HOST}:"
    run_ssh "systemctl --failed --no-pager" || true
  fi

  # Delegate host-specific service/DNS checks to the host's declarative nixos-auto-update-canary
  if run_ssh "command -v nixos-auto-update-canary &>/dev/null"; then
    info "Running declarative host canary suite on ${TARGET_HOST}..."
    if ! run_ssh "nixos-auto-update-canary"; then
      error "Declarative canary check failed on ${TARGET_HOST}!"
      return 1
    fi
  else
    STATE=$(run_ssh "systemctl is-system-running 2>/dev/null" || echo "unknown")
    if [[ "$STATE" != "running" && "$STATE" != "degraded" ]]; then
      error "System responsiveness canary failed: system state is '${STATE}' on ${TARGET_HOST}!"
      return 1
    elif [[ "$STATE" == "degraded" ]]; then
      warn "Target host reported 'degraded' system state (non-critical service failures present)."
    fi
  fi

  # External DNS verification from operator host for router deployments
  if [[ "$TARGET_HOST" == "michael" ]]; then
    info "Verifying external DNS resolution via @${TARGET_ADDRESS}..."
    DNS_RES=""
    for _ in {1..5}; do
      DNS_RES=$(dig "@${TARGET_ADDRESS}" nixos.org +short +time=2 +tries=1 2>/dev/null || true)
      if [[ -n "$DNS_RES" ]]; then
        break
      fi
      sleep 1
    done
    if [[ -z "$DNS_RES" ]]; then
      error "External DNS resolution query to @${TARGET_ADDRESS} returned no answer!"
      return 1
    fi
  fi
}

# 3. Canary Verification Suite
trap rollback ERR

info "Verifying SSH and host health on ${TARGET_HOST}..."
sleep 2
verify_canaries

trap - ERR
success "All canary checks passed successfully on ${TARGET_HOST}!"

# 4. Finalize
if [ "$TEST_ONLY" = true ]; then
  warn "Skipping bootloader update (--test-only specified). Running configuration is active in RAM."
  exit 0
fi

info "Persisting configuration to bootloader via 'nixos-rebuild switch'..."
SWITCH_STARTED=true
SWITCH_CMD=(nixos-rebuild switch --flake "${ROOT_DIR}#${TARGET_HOST}" --target-host "${SSH_TARGET}" "$ELEVATE_FLAG" "${NIX_OPTIONS[@]}")
if [[ -n "$BUILD_HOST" ]]; then
  SWITCH_CMD+=(--build-host "$BUILD_HOST")
fi

if ! "${SWITCH_CMD[@]}"; then
  error "Failed to persist configuration to bootloader on ${TARGET_HOST}."
  rollback
fi

info "Verifying post-finalization health..."
if ! verify_canaries; then
  rollback
fi

# Fast-forward remote git repo only when on master with a clean working tree
# shellcheck disable=SC2016
if run_ssh 'test -d "$HOME/Projects/nixcfg/.git"' &>/dev/null; then
  info "Synchronizing remote git repository on ${TARGET_HOST} (if clean on master)..."
  # shellcheck disable=SC2016
  run_ssh '
    cd "$HOME/Projects/nixcfg" || exit 0
    branch=$(git branch --show-current 2>/dev/null || echo "")
    if [ "$branch" = "master" ] && git diff --quiet && git diff --cached --quiet; then
      git fetch origin master && git merge --ff-only origin/master
    fi
  ' &>/dev/null || true
fi

success "Successfully deployed and finalized update on ${TARGET_HOST}!"
